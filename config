ngx_addon_name=ngx_http_proxy_auth_internal_module

if [ "$ngx_module_link" = DYNAMIC ]; then
    echo "$0: error: ngx_http_proxy_auth_internal_module must be built with --add-module"
    exit 1
fi
ngx_module_srcs="$ngx_addon_dir/ngx_http_proxy_auth_internal_module.c"

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=$ngx_addon_name

    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES $ngx_addon_name"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_module_srcs"
fi
